# MOVIEBOX_API_KEY: Primary catalog and streaming API key for Muvio Source 1.
MOVIEBOX_API_KEY=YOUR_MOVIEBOX_API_KEY

# SECONDARY_CATALOG_API_KEY: Secondary catalog and streaming API key for Muvio Source 2.
SECONDARY_CATALOG_API_KEY=YOUR_SECONDARY_CATALOG_API_KEY

# REMOTE_CONFIG_URL: Optional public JSON URL (GitHub Raw / Render / Cloudflare) for live banners, dynamic server URLs & in-app update notices.
REMOTE_CONFIG_URL=YOUR_REMOTE_CONFIG_JSON_URL